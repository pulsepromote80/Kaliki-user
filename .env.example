# ---------------------------------------------------------------------------
# Server-only variables (NEVER prefix these with NEXT_PUBLIC_).
# These are read only inside Route Handlers / middleware / server components.
# ---------------------------------------------------------------------------

# Base URL of the ASP.NET Core Web API backend. Server-side only.
BACKEND_API_URL=https://localhost:5001/api

# Secret used to verify/sign session-related tokens on the server, if needed.
AUTH_SECRET=replace-with-a-strong-random-secret

# Name of the HttpOnly cookie that stores the session/access token.
SESSION_COOKIE_NAME=session_token

# Optional server-only codes required by the corresponding Fund Director
# transaction endpoints. Configure these with the approved backend values.
FUND_DIRECTOR_INCOME_AUTH_CODE=
FUND_DIRECTOR_P2P_AUTH_CODE=
FUND_DIRECTOR_WITHDRAWAL_SECURE_CODE=

# ---------------------------------------------------------------------------
# Public variables (safe to expose to the browser).
# Only non-sensitive, non-backend values belong here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="KALKII"
NEXT_PUBLIC_APP_URL=http://localhost:3000
